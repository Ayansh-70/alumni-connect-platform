PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/alumni-connect
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="AlumniConnect <noreply@alumniconnect.com>"

# Rate Limiting (Demo Defaults shown)
# For Production, recommend lowering MAX limits (e.g. 5, 3, 5 respectively)
LOGIN_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=20
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=30
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
